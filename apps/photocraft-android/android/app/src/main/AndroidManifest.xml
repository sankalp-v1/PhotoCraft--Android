<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Updates: the release list and APK from GitHub, installed through Android's installer
         (Updater.java). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- wgpu renders with Vulkan, or OpenGL ES 3 where Vulkan is missing. -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature android:name="android.hardware.vulkan.level" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:label="PhotoCraft"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.PhotoCraft"
        android:largeHeap="true"
        android:resizeableActivity="true"
        android:appCategory="productivity"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules">

        <!-- configChanges lists every change Android would otherwise restart the Activity for
             (a keyboard or mouse attached, the system font size, language or bold text changed,
             a SIM swapped, DeX): a restarted Activity can't start the Rust app again in the same
             process (winit's event loop exists once), so a restart would end the session. The
             app draws everything itself and needs none of them.
             appCategory: not a game, though it runs on GameActivity; device makers' game
             services cap the frame rate of what they take for one. -->
        <activity
            android:name=".PhotoCraftActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|touchscreen|mcc|mnc|locale|layoutDirection|fontScale|fontWeightAdjustment|colorMode|grammaticalGender"
            android:windowSoftInputMode="adjustResize">

            <!-- The Rust library GameActivity loads (libphotocraft_android.so). -->
            <meta-data android:name="android.app.lib_name" android:value="photocraft_android" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- "Open with PhotoCraft" and "Share to PhotoCraft" for images and documents. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>
    </application>
</manifest>
